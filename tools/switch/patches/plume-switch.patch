+            if (memcmp(before, allocation, size) == 0) return;
+            fprintf(stderr, "[texguard] allocation record %p (%zu bytes) of texture %p changed during %s; image %p view %p\n",
+                    allocation, size, object, step, image, view);
+            const unsigned char *now = static_cast<const unsigned char *>(allocation);
+            for (size_t off = 0; off + 8 <= size; off += 8) {
