@@ -3849,6 +3897,14 @@ namespace plume {
 
         // Store properties.
         vkGetPhysicalDeviceProperties(physicalDevice, &physicalDeviceProperties);
+#   if defined(__SWITCH__)
+        // NVK reports a 1 ns timestamp period, as on desktop GPUs, but the Switch
+        // GPU timer runs at 614.4 MHz (625/384 ns per tick). Timings read as 1 ns
+        // ticks come out 1.63x too short.
+        if (physicalDeviceProperties.limits.timestampPeriod == 1.0f) {
+            physicalDeviceProperties.limits.timestampPeriod = 625.0f / 384.0f;
+        }
+#   endif
 
         // Check for supported features.
         void *featuresChain = nullptr;
@@ -4481,7 +4537,23 @@ namespace plume {
     // VulkanInterface
 
     VulkanInterface::VulkanInterface() {
+#   if defined(__SWITCH__)
+        // Mesa NVK is linked statically (no Vulkan loader on Horizon): volk gets
+        // its entry point from the ICD interface instead of a loaded library.
+        VkResult res = VK_SUCCESS;
+        if (volkGetInstanceVersion() == 0) {
+            uint32_t icdVersion = 7;
+            vk_icdNegotiateLoaderICDInterfaceVersion(&icdVersion);
+            PFN_vkGetInstanceProcAddr getInstanceProcAddr = reinterpret_cast<PFN_vkGetInstanceProcAddr>(
+                vk_icdGetInstanceProcAddr(VK_NULL_HANDLE, "vkGetInstanceProcAddr"));
+            if (getInstanceProcAddr == nullptr) {
+                getInstanceProcAddr = reinterpret_cast<PFN_vkGetInstanceProcAddr>(&vk_icdGetInstanceProcAddr);
+            }
+            volkInitializeCustom(getInstanceProcAddr);
+        }
+#   else
         VkResult res = volkInitialize();
+#   endif
         if (res != VK_SUCCESS) {
             fprintf(stderr, "volkInitialize failed with error code 0x%X.\n", res);
             return;
