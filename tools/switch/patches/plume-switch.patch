+                memcpy(&a, before + off, 8);
+                memcpy(&b, now + off, 8);
+                if (a != b) fprintf(stderr, "[texguard]   +0x%02zx: %016llx -> %016llx\n", off, (unsigned long long)a, (unsigned long long)b);
+            }
+            const intptr_t rec = reinterpret_cast<intptr_t>(allocation);
+            fprintf(stderr, "[texguard]   record - image = %lld, record - view = %lld, record - texture = %lld\n",
+                    (long long)(rec - reinterpret_cast<intptr_t>(image)), (long long)(rec - reinterpret_cast<intptr_t>(view)),
+                    (long long)(rec - reinterpret_cast<intptr_t>(object)));
