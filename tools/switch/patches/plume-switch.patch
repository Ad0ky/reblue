+#if defined(__SWITCH__)
+    // reblue (Switch): the pipeline cache on the SD card (see plume_vulkan.h).
+    namespace {
+        std::mutex pipelineCachePathMutex;
+        std::string pipelineCachePath;
+
+        std::string PipelineCachePath() {
+            std::lock_guard<std::mutex> lock(pipelineCachePathMutex);
+            return pipelineCachePath;
+        }
+
+        std::vector<uint8_t> ReadWholeFile(const std::string &path) {
+            std::vector<uint8_t> data;
+            if (FILE *f = fopen(path.c_str(), "rb")) {
+                if (fseek(f, 0, SEEK_END) == 0) {
+                    const long size = ftell(f);
+                    if (size > 0 && fseek(f, 0, SEEK_SET) == 0) {
+                        data.resize(size_t(size));
+                        if (fread(data.data(), 1, data.size(), f) != data.size()) {
+                            data.clear();
+                        }
+                    }
+                }
+                fclose(f);
+            }
+            return data;
+        }
+    }
+
+    void VulkanSetPipelineCachePath(const std::string &path) {
+        std::lock_guard<std::mutex> lock(pipelineCachePathMutex);
+        pipelineCachePath = path;
+    }
+
+    struct VulkanDevice::PipelineCacheSaver {
+        VulkanDevice *device = nullptr;
+        std::string path;
+        std::mutex mutex;
+        std::condition_variable cv;
+        uint32_t unsaved = 0;
+        bool stop = false;
+        std::thread thread;
+
+        // Writes beside the file and renames, so a power-off mid-write never
+        // leaves a torn cache behind.
+        void save() {
+            size_t size = 0;
+            if (vkGetPipelineCacheData(device->vk, device->pipelineCache, &size, nullptr) != VK_SUCCESS || size == 0) {
+                return;
+            }
+            std::vector<uint8_t> data(size);
+            if (vkGetPipelineCacheData(device->vk, device->pipelineCache, &size, data.data()) != VK_SUCCESS) {
+                return;
+            }
+            const std::string tmp = path + ".tmp";
+            FILE *f = fopen(tmp.c_str(), "wb");
+            if (!f) {
+                return;
+            }
+            const bool ok = fwrite(data.data(), 1, size, f) == size;
+            fclose(f);
+            if (!ok) {
+                remove(tmp.c_str());
+                return;
+            }
+            remove(path.c_str());
+            rename(tmp.c_str(), path.c_str());
+        }
+
+        void run() {
+            std::unique_lock<std::mutex> lock(mutex);
+            while (!stop) {
+                // A batch of new pipelines usually arrives with a load: wait for
+                // it to settle, then save once.
+                cv.wait_for(lock, std::chrono::seconds(10));
+                if (unsaved > 0 && !stop) {
+                    unsaved = 0;
+                    lock.unlock();
+                    save();
+                    lock.lock();
+                }
+            }
+        }
+    };
+
+    void VulkanDevice::pipelineCreated() {
+        if (!pipelineCacheSaver) {
+            return;
+        }
+        std::lock_guard<std::mutex> lock(pipelineCacheSaver->mutex);
+        ++pipelineCacheSaver->unsaved;
+    }
+#endif
