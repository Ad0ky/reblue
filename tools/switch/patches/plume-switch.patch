+            for (int i = 0; i < kFrames && r.frames[i] != 0; ++i) fprintf(stderr, " 0x%lx", (unsigned long)r.frames[i]);
+            fprintf(stderr, "\n");
+        }
+
+        void printRecent(const void *object) {
+            for (uint32_t i = 0; i < 1024; ++i) {
+                const Record &old = recent[(recentNext + 1023 - i) % 1024];
+                if (old.object == object) { print("earlier destroy", old); return; }
+            }
+        }
+
+        [[noreturn]] void fail() {
+            fflush(stderr);
+            abort();
+        }
+
+        void created(const void *object, const void *allocation, Kind kind) {
+            Record r;
+            r.object = object;
+            r.allocation = allocation;
+            r.kind = kind;
+            if (allocation != nullptr) memcpy(r.allocationHead, allocation, sizeof(r.allocationHead));
+            capture(r.frames);
+            std::lock_guard<std::mutex> lock(mutex);
+            if (!announced) {
+                announced = true;
+                fprintf(stderr, "[texguard] active; libstdc++ threads %s (std::mutex %s)\n",
+                        __gthread_active_p() ? "active" : "INACTIVE",
+                        __gthread_active_p() ? "locks" : "DOES NOTHING");
+            }
+            if (allocation != nullptr) {
+                auto it = owners.find(allocation);
+                if (it != owners.end()) {
+                    fprintf(stderr, "[texguard] VMA returned allocation %p that a live object still owns\n", allocation);
+                    print("new object", r);
