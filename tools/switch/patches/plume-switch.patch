+    bool Deko3DSetBlendConstant(RenderCommandList *commandList, const float rgba[4]) {
+        if (!commandList)
+            return false;
+        static_cast<Deko3DCommandList *>(commandList)->setBlendConstant(rgba);
+        return true;
+    }
