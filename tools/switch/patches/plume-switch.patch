+#if defined(__SWITCH__)
+    // reblue (Switch): resource lifetime guard, a diagnostic for a crash in
+    // vmaDestroyImage on an allocation record that VMA had already put back on
+    // its free list while the texture owning it was still alive. Every
+    // texture and buffer that owns a VMA allocation is tracked:
+    //   - an allocation VMA hands out while another live object owns it,
+    //   - an object destroyed twice or never seen created,
+    //   - a texture whose allocation record changed under it,
+    // print the call chains involved to stderr (rex_stderr.log) as offsets
+    // into reblue.elf and abort, so the crash hooks write rex_crash.log too.
+    namespace switchguard {
+        extern "C" char _start[];
+        constexpr int kFrames = 12;
+        enum Kind : uint8_t { Texture = 0, Buffer = 1 };
+        struct Record {
+            const void *object = nullptr;
+            const void *allocation = nullptr;
+            Kind kind = Texture;
+            uint64_t allocationHead[2] = {};
+            uintptr_t frames[kFrames] = {};
+        };
+        std::mutex mutex;
+        std::unordered_map<const void *, Record> live;          // object -> creation
+        std::unordered_map<const void *, const void *> owners;  // allocation -> object
+        Record recent[1024];
+        uint32_t recentNext = 0;
+        bool announced = false;
+
+        const char *name(Kind k) { return k == Texture ? "texture" : "buffer"; }
+
+        void capture(uintptr_t *out) {
+            const uintptr_t base = reinterpret_cast<uintptr_t>(&_start[0]);
+            void **fp = static_cast<void **>(__builtin_frame_address(0));
+            int i = 0;
+            for (; i < kFrames && fp != nullptr; ++i) {
+                const uintptr_t ret = reinterpret_cast<uintptr_t>(fp[1]);
+                out[i] = ret >= base ? ret - base : ret;
+                void **next = static_cast<void **>(fp[0]);
+                if (next <= fp || (reinterpret_cast<uintptr_t>(next) & 0xF) != 0) { ++i; break; }
+                fp = next;
+            }
+            for (; i < kFrames; ++i) out[i] = 0;
+        }
+
+        void print(const char *what, const Record &r) {
+            fprintf(stderr, "[texguard]   %s: %s %p allocation %p (head %016llx %016llx), chain (reblue.elf+):", what, name(r.kind),
+                    r.object, r.allocation, (unsigned long long)r.allocationHead[0], (unsigned long long)r.allocationHead[1]);
+            for (int i = 0; i < kFrames && r.frames[i] != 0; ++i) fprintf(stderr, " 0x%lx", (unsigned long)r.frames[i]);
+            fprintf(stderr, "\n");
+        }
+
+        void printRecent(const void *object) {
+            for (uint32_t i = 0; i < 1024; ++i) {
+                const Record &old = recent[(recentNext + 1023 - i) % 1024];
+                if (old.object == object) { print("earlier destroy", old); return; }
+            }
+        }
+
+        [[noreturn]] void fail() {
+            fflush(stderr);
+            abort();
+        }
+
+        void created(const void *object, const void *allocation, Kind kind) {
+            Record r;
+            r.object = object;
+            r.allocation = allocation;
+            r.kind = kind;
+            if (allocation != nullptr) memcpy(r.allocationHead, allocation, sizeof(r.allocationHead));
+            capture(r.frames);
+            std::lock_guard<std::mutex> lock(mutex);
+            if (!announced) {
+                announced = true;
+                fprintf(stderr, "[texguard] active; libstdc++ threads %s (std::mutex %s)\n",
+                        __gthread_active_p() ? "active" : "INACTIVE",
+                        __gthread_active_p() ? "locks" : "DOES NOTHING");
+            }
+            if (allocation != nullptr) {
+                auto it = owners.find(allocation);
+                if (it != owners.end()) {
+                    fprintf(stderr, "[texguard] VMA returned allocation %p that a live object still owns\n", allocation);
+                    print("new object", r);
+                    auto l = live.find(it->second);
+                    if (l != live.end()) print("current owner, created at", l->second);
+                    fail();
+                }
+                owners[allocation] = object;
+            }
+            live[object] = r;
+        }
+
+        void destroying(const void *object, const void *allocation, Kind kind) {
+            Record r;
+            r.object = object;
+            r.allocation = allocation;
+            r.kind = kind;
+            if (allocation != nullptr) memcpy(r.allocationHead, allocation, sizeof(r.allocationHead));
+            capture(r.frames);
+            std::lock_guard<std::mutex> lock(mutex);
+            auto it = live.find(object);
+            if (it == live.end()) {
+                fprintf(stderr, "[texguard] %s %p destroyed but not live (double destroy?)\n", name(kind), object);
+                print("this destroy", r);
+                printRecent(object);
+                fail();
+            }
+            if (allocation != nullptr) {
+                auto o = owners.find(allocation);
+                if (o == owners.end() || o->second != object) {
+                    fprintf(stderr, "[texguard] %s %p frees allocation %p it does not own\n", name(kind), object, allocation);
+                    print("this destroy", r);
+                    print("created at", it->second);
+                    fail();
+                }
+                if (kind == Texture && r.allocationHead[0] != it->second.allocationHead[0]) {
+                    fprintf(stderr, "[texguard] allocation record of texture %p changed while it was alive "
+                                    "(freed by VMA or overwritten)\n", object);
+                    print("now", r);
+                    print("created at", it->second);
+                    fail();
+                }
+                owners.erase(o);
+            }
+            live.erase(it);
+            recent[recentNext] = r;
+            recentNext = (recentNext + 1) % 1024;
+        }
+    }
+#endif
