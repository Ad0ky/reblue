+    // print the call chains involved to stderr (rex_stderr.log) as offsets
+    // into reblue.elf and abort, so the crash hooks write rex_crash.log too.
+    namespace switchguard {
+        extern "C" char _start[];
+        constexpr int kFrames = 12;
+        enum Kind : uint8_t { Texture = 0, Buffer = 1 };
+        struct Record {
+            const void *object = nullptr;
+            const void *allocation = nullptr;
+            Kind kind = Texture;
+            uint64_t allocationHead[2] = {};
+            uintptr_t frames[kFrames] = {};
+        };
+        std::mutex mutex;
+        std::unordered_map<const void *, Record> live;          // object -> creation
+        std::unordered_map<const void *, const void *> owners;  // allocation -> object
+        Record recent[1024];
